# Copy to .env and replace hostnames with deployment-local values.
AGENTS_DB=/opt/agents/data/agents.sqlite3
WEB_HOST=web-host.example
PORT=80

COORDINATOR_LLM_URL=http://inference-host.example:8080/v1/chat/completions
COORDINATOR_LLM_RESPONSE_TIMEOUT=300
COORDINATOR_MAX_DELEGATIONS=8
COORDINATOR_MAX_TIMEOUTS=3
COORDINATOR_MAX_PROTOCOL_ERRORS=3

EXECUTOR_LLM_URL=http://inference-host.example:8080/v1/chat/completions
EXECUTOR_LLM_RESPONSE_TIMEOUT=300
EXECUTOR_TIMEOUT=300
EXECUTOR_COMMAND_TIMEOUT=30

DEVELOPER_LLM_URL=http://inference-host.example:8080/v1/chat/completions
DEVELOPER_LLM_RESPONSE_TIMEOUT=300
DEVELOPER_TIMEOUT=300
DEVELOPER_COMMAND_TIMEOUT=120
DEVELOPER_MAX_TOKENS=700

# Used by operational scripts and local AGENTS instructions.
PROXMOX_SSH_TARGET=root@proxmox-host.example
INFERENCE_SSH_TARGET=root@inference-host.example
WEB_SSH_TARGET=root@web-host.example
