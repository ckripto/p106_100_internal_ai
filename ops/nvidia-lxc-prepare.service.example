[Unit]
Description=Prepare NVIDIA devices for GPU-backed LXC guests
After=systemd-modules-load.service systemd-udev-trigger.service
Before=pve-guests.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nvidia-lxc-prepare
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
