#!/bin/sh
set -eu

modprobe nvidia
modprobe nvidia_uvm

remaining_attempts=240

wait_or_fail() {
    message=$1
    if [ "$remaining_attempts" -le 0 ]; then
        echo "$message" >&2
        exit 1
    fi
    remaining_attempts=$((remaining_attempts - 1))
    sleep 1
}

while :; do
    found_gpu=0
    all_gpu_nodes_ready=1
    for information in /proc/driver/nvidia/gpus/*/information; do
        [ -f "$information" ] || continue
        minor=$(awk -F: '/^Device Minor:/ { gsub(/[[:space:]]/, "", $2); print $2 }' "$information")
        [ -n "$minor" ] || continue
        found_gpu=1
        if ! nvidia-modprobe -c "$minor" >/dev/null 2>&1 ||
            ! test -c "/dev/nvidia$minor"; then
            all_gpu_nodes_ready=0
        fi
    done

    if [ "$found_gpu" -eq 1 ] && [ "$all_gpu_nodes_ready" -eq 1 ]; then
        break
    fi
    wait_or_fail "NVIDIA GPU device nodes did not become ready"
done

# Per-GPU -c calls do not create nvidiactl; the default and -u modes create
# the control and UVM nodes respectively on a cold boot.
until nvidia-modprobe >/dev/null 2>&1 &&
    nvidia-modprobe -u >/dev/null 2>&1 &&
    test -c /dev/nvidiactl &&
    test -c /dev/nvidia-uvm &&
    test -c /dev/nvidia-uvm-tools; do
    wait_or_fail "NVIDIA control/UVM device nodes did not become ready"
done

until nvidia-smi --query-gpu=index --format=csv,noheader >/dev/null 2>&1; do
    wait_or_fail "NVIDIA GPUs did not become responsive"
done
