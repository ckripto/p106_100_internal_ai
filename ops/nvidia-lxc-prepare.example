#!/bin/sh
set -eu

modprobe nvidia
modprobe nvidia_uvm

found_gpu=0
for information in /proc/driver/nvidia/gpus/*/information; do
    [ -f "$information" ] || continue
    minor=$(awk -F: '/^Device Minor:/ { gsub(/[[:space:]]/, "", $2); print $2 }' "$information")
    [ -n "$minor" ] || continue
    nvidia-modprobe -c "$minor"
    test -c "/dev/nvidia$minor"
    found_gpu=1
done

[ "$found_gpu" -eq 1 ]
nvidia-modprobe -u
test -c /dev/nvidiactl
test -c /dev/nvidia-uvm
test -c /dev/nvidia-uvm-tools
nvidia-smi --query-gpu=index --format=csv,noheader >/dev/null
