LLAMA_MODEL=publisher/model-file
LLAMA_TENSOR_SPLIT=1,1
# Total KV context shared by all parallel slots.
LLAMA_CONTEXT_SIZE=4096
LLAMA_PARALLEL=1
# Bound the host-side saved prompt cache; active KV remains on the GPUs.
LLAMA_CACHE_RAM=1024
# Direct I/O avoids retaining offloaded GGUF weights in the filesystem page cache.
LLAMA_LOAD_MODE=dio
LLAMA_THREADS=2
LLAMA_HOST=inference-host.example
LLAMA_PORT=8080
CUDA_VISIBLE_DEVICES=0,1
